# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Login role that is a member of dyce_api (NOT a superuser). See db/migrations/0006_roles_and_config.sql.
DATABASE_URL=postgres://dyce_app:dyce_app@localhost:5432/dyce
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PHONE_HASH_SALT=change-me-too-16+chars
