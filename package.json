{
  "name": "dyce",
  "version": "0.0.0",
  "private": true,
  "description": "Dyce: chat-first games with friends. The Expo app (iOS, Android, web guest). The backend is the sibling repo dyce-backend.",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "eslint app src packages",
    "typecheck": "tsc --noEmit && pnpm -F @dyce/ui typecheck",
    "test": "jest && pnpm -F @dyce/ui test",
    "e2e": "maestro test e2e/",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml}\"",
    "prepare": "husky",
    "eas-build-pre-install": "node tools/release/fetch-backend.mjs",
    "release:check": "node tools/release/check-release-config.mjs",
    "test:tools": "node --test tools/release/native-changed.test.mjs"
  },
  "dependencies": {
    "@dyce/games": "link:../dyce-backend/packages/games",
    "@dyce/shared": "link:../dyce-backend/packages/shared",
    "@dyce/ui": "workspace:*",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-three/fiber": "^9.8.2",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.107.1",
    "colyseus.js": "^0.16.22",
    "expo": "^58.0.25",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-contacts": "~58.0.11",
    "expo-font": "~58.0.12",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "^58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "libphonenumber-js": "^1.13.16",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "^0.187.0",
    "zod": "^4.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
