# Build-time configuration for the Expo app. NO SECRETS: every EXPO_PUBLIC_* value is compiled into the app and
# readable by anyone who downloads it. (A Sentry DSN and a PostHog project key are designed to be public.)
#
# Local development: copy to .env (git-ignored). EAS builds: set the same names per profile as EAS environment
# variables, NOT in this file or in eas.json:
#   eas env:create --environment production --name EXPO_PUBLIC_SENTRY_DSN --value <dsn> --visibility plaintext
# The three environments are `development`, `preview` and `production` (the same names as the build profiles).
# docs/RELEASE_CHECKLIST.md lists every account these need.

# Which variant this build is: development | preview | production. Set by the profile in eas.json; it changes the
# application id (games.dyce.app, .preview, .dev), the name, the link scheme and whether OTA updates are on.
APP_ENV=development

# Where the app talks to. Android emulators reach the host machine at 10.0.2.2: a localhost URL is rewritten for you.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# Store pages for the invite landing page's "Get it on iPhone / Android". Unset until the listings exist.
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=

# Error reporting. EMPTY = Sentry is not loaded and nothing is sent.
EXPO_PUBLIC_SENTRY_DSN=
# Product analytics. EMPTY = events go to the dev console only.
EXPO_PUBLIC_POSTHOG_KEY=
# Optional. Default https://eu.i.posthog.com (the EU cloud); use https://us.i.posthog.com for the US cloud.
EXPO_PUBLIC_POSTHOG_HOST=

# --- Build-time, NOT compiled into the app ------------------------------------------------------------------------
# Created by `eas init`. Turns on over-the-air updates (app.config.ts adds the update URL and the project id).
EAS_PROJECT_ID=
# Upload source maps and native symbols to Sentry during the build. Needs SENTRY_AUTH_TOKEN as an EAS *secret*
# (visibility "secret"); never put the token here. Leave SENTRY_ORG / SENTRY_PROJECT empty to skip the upload.
SENTRY_ORG=
SENTRY_PROJECT=
# EAS builder only (tools/release/fetch-backend.mjs): which backend repository and commit to build against.
# Production builds must pin BACKEND_REF to a commit or tag. BACKEND_REPO_TOKEN is an EAS secret (read-only).
BACKEND_REPO=dyce-game/dyce-backend
BACKEND_REF=
